{
  "$id": "https://kjanat.github.io/actionlint-plugin-registry/schemas/manifest.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Generated per-plugin version manifest",
  "type": "object",
  "required": [
    "plugin",
    "versions"
  ],
  "properties": {
    "plugin": {
      "$ref": "plugin.schema.json"
    },
    "versions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "compatibility",
          "record",
          "version"
        ],
        "properties": {
          "compatibility": {
            "description": "Independent host observations; an empty list means untested.",
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "host",
                "outcome",
                "policy",
                "report"
              ],
              "properties": {
                "host": {
                  "$ref": "compatibility.schema.json#/$defs/host"
                },
                "outcome": {
                  "enum": [
                    "passed",
                    "failed",
                    "unsupported"
                  ]
                },
                "policy": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256
                },
                "report": {
                  "type": "string",
                  "pattern": "^../../compatibility/[a-f0-9]{64}/[a-f0-9]{64}\\.json$"
                }
              },
              "additionalProperties": false
            }
          },
          "record": {
            "type": "string",
            "pattern": "^versions/[a-f0-9]{64}\\.json$"
          },
          "version": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
