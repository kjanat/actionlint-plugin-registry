{
  "$id": "https://kjanat.github.io/actionlint-plugin-registry/schemas/version.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "commit": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    }
  },
  "title": "Immutable accepted plugin version",
  "type": "object",
  "required": [
    "accepted_at",
    "asset_id",
    "commit",
    "owner_id",
    "published_at",
    "receipt",
    "release_id",
    "repository_id",
    "submission",
    "upstream_immutable",
    "url",
    "validation"
  ],
  "properties": {
    "accepted_at": {
      "type": "string",
      "format": "date-time"
    },
    "asset_id": {
      "type": "integer",
      "minimum": 0
    },
    "commit": {
      "$ref": "#/$defs/commit"
    },
    "owner_id": {
      "type": "integer",
      "minimum": 1
    },
    "published_at": {
      "type": "string",
      "format": "date-time"
    },
    "receipt": {
      "$ref": "receipt.schema.json"
    },
    "release_id": {
      "type": "integer",
      "minimum": 0
    },
    "repository_id": {
      "type": "integer",
      "minimum": 1
    },
    "submission": {
      "$ref": "submission.schema.json"
    },
    "upstream_immutable": {
      "type": "boolean"
    },
    "url": {
      "type": "string",
      "format": "uri"
    },
    "validation": {
      "type": "object",
      "required": [
        "checks",
        "contract",
        "host_commit",
        "kind",
        "metadata",
        "plugin_id",
        "plugin_version",
        "policy_version",
        "repository",
        "rules"
      ],
      "properties": {
        "checks": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "contract": {
          "type": "string",
          "minLength": 1
        },
        "host_commit": {
          "$ref": "#/$defs/commit"
        },
        "kind": {
          "enum": [
            "core",
            "component"
          ]
        },
        "metadata": {
          "type": "object"
        },
        "plugin_id": {
          "type": "string",
          "minLength": 1
        },
        "plugin_version": {
          "type": "string"
        },
        "policy_version": {
          "const": "1"
        },
        "repository": {
          "type": "string",
          "format": "uri"
        },
        "rules": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
