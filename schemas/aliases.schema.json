{
  "$id": "https://plugins.actionlint.kjanat.dev/schemas/aliases.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Registry-maintained plugin alias assignments",
  "type": "object",
  "required": [
    "aliases",
    "schema_version"
  ],
  "properties": {
    "aliases": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "repository"
        ],
        "properties": {
          "repository": {
            "type": "string",
            "pattern": "^(github|gitlab)\\.com/[a-z0-9][a-z0-9_-]*(/[a-z0-9][a-z0-9._-]*)+$"
          },
          "reserved": {
            "default": false,
            "type": "boolean"
          }
        },
        "additionalProperties": false
      },
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9-]{0,63}$"
      }
    },
    "schema_version": {
      "const": 1
    }
  },
  "additionalProperties": false
}
