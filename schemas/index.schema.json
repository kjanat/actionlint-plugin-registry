{
  "$id": "https://plugins.actionlint.kjanat.dev/schemas/index.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Generated plugin catalog",
  "type": "object",
  "required": [
    "plugins",
    "schema_version"
  ],
  "properties": {
    "plugins": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "manifest",
          "name",
          "plugin_id"
        ],
        "properties": {
          "aliases": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]{0,63}$"
            }
          },
          "manifest": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "plugin_id": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      }
    },
    "schema_version": {
      "const": 1
    },
    "statuses": {
      "type": "string",
      "const": "statuses.json"
    }
  },
  "additionalProperties": false
}
