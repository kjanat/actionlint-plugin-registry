// Folder-specific settings
// vim: set ft=jsonc:
//
// For a full list of overridable settings, and general information on folder-specific settings,
// see the documentation: https://zed.dev/docs/configuring-zed#settings-files
//
// mkdir -p .zed; curl -fsSLo .zed/settings.json https://github.com/kjanat/kjanat/raw/HEAD/.zed/settings.json
{
  "formatter": [{ "language_server": { "name": "dprint" } }],
  "prettier": { "allowed": false },
  "languages": {
    "JavaScript": {
      "language_servers": [
        "typescript", // https://github.com/kjanat/zed-typescript
        "dprint",
        "biome"
      ],
      "code_actions_on_format": {
        "source.fixAll.biome": true,
        "source.organizeImports.biome": true
      }
    },
    "TypeScript": {
      "format_on_save": "on",
      "language_servers": [
        "typescript", // https://github.com/kjanat/zed-typescript
        "dprint",
        "biome"
      ],
      "code_actions_on_format": {
        "source.fixAll.biome": true,
        "source.organizeImports.biome": true
      }
    },
    "Markdown": {}
  },
  "markdown_preview": { // available in per-project config since https://github.com/kjanat/zed-editor v1.4.10
    "limit_content_width": false,
    "open_markdown_files_in_preview": false
  },
  "lsp": {
    "dprint": {
      "binary": {
        "path": "mise",
        "arguments": ["exec", "--silent", "github:kjanat/dprint@latest", "--", "dprint", "lsp"],
        "env": {},
      }
    },
    "gopls": {
      "binary": {
        "path": "go",
        "arguments": ["run", "golang.org/x/tools/gopls@latest"],
        "env": { "MISE_SILENT": "1" },
      },
      "initialization_options": {
        "buildFlags": ["-buildvcs=true"],
        "local": "registry.actionlint.kjanat.dev",
        "gofumpt": true,
        "staticcheck": true,
        "usePlaceholders": true,
        "vulncheck": "Imports",
        "hints": {
          "ignoredError": true,
          "parameterNames": true,
          "constantValues": true,
          "functionTypeParameters": true,
        },
        "hoverKind": "SynopsisDocumentation"
      }
    },
    "golangci-lint": {
      "binary": {
        "env": {}
      },
      "initialization_options": {
        "command": [
          "mise",
          "exec",
          "--silent",
          "golangci-lint@latest",
          "--",
          "golangci-lint",
          "run",
          "--output.json.path",
          "stdout",
          "--show-stats=false",
          "--output.text.path=",
          "--issues-exit-code=1"
        ]
      }
    },
    "biome": {
      "binary": {
        "path": "mise",
        "arguments": ["exec", "--silent", "biome@latest", "--", "biome", "lsp-proxy"],
        "env": {},
      },
      "settings": {
        "config_path": "./worker/biome.json",
        "require_config_file": true,
        "inline_config": {
          "formatter": { "enabled": false },
          "linter": {
            "rules": {
              "suspicious": { "noConsole": "off" }
            }
          },
          "source": {
            "organizeImports": true
          }
        }
      }
    },
    "markdownlint": {
      "settings": {
        "MD013": false,
        "MD034": false
      }
    },
    "json-language-server": {
      "settings": {
        "json": {
          "schemas": [{
            "fileMatch": ["index.json"],
            "url": "schemas/index.schema.json"
          }, {
            "fileMatch": ["sources.json"],
            "url": "schemas/submission.schema.json"
          }, {
            "fileMatch": ["wrangler.json", "wrangler.jsonc"],
            "url": "https://www.unpkg.com/wrangler/config-schema.json"
          }]
        }
      }
    }
  }
}
