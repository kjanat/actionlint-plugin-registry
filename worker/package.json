{
  "name": "@kjanat-actionlint/plugin-publication-inbox",
  "private": true,
  "type": "module",
  "imports": {
    "#*": "./src/*.ts"
  },
  "scripts": {
    "check:bundle": "wrangler deploy --dry-run --outdir .dry-run",
    "deploy": "wrangler deploy",
    "lint": "biome lint --error-on-warnings",
    "prepare": "wrangler types",
    "test": "bun test",
    "test:runtime": "node scripts/runtime-dispatch.ts && node scripts/runtime-recovery.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "jose": "catalog:worker"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:worker",
    "@types/bun": "catalog:",
    "miniflare": "catalog:worker",
    "typescript": "catalog:",
    "wrangler": "catalog:worker"
  },
  "devEngines": {
    "packageManager": {
      "name": "bun",
      "onFail": "error"
    }
  }
}
