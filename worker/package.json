{
  "name": "@kjanat-actionlint/plugin-publication-inbox",
  "private": true,
  "type": "module",
  "imports": {
    "#*": "./src/*.ts"
  },
  "scripts": {
    "lint": "biome lint src test --error-on-warnings",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "prepare": "wrangler types",
    "check:bundle": "wrangler deploy --dry-run --outdir .dry-run"
  },
  "dependencies": {
    "jose": "6.2.12"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/bun": "1.4.3",
    "typescript": "7.0.2",
    "wrangler": "4.151.2"
  },
  "devEngines": {
    "packageManager": {
      "name": "bun",
      "onFail": "error"
    }
  }
}
