      },
      "contract_sha256": "a0096f562ab3da46b30d0f025ad1c6ed0d46e5b7ea1a53660b3214e3270fcbee",
      "description": "ShellCheck for actionlint run steps as a WebAssembly component, built on shellcheck-rs",
      "descriptor": {
        "category": "correctness",
        "description": "ShellCheck for actionlint run steps as a WebAssembly component, built on shellcheck-rs",
        "documentation_url": "https://github.com/kjanat/actionlint-plugin-shellcheck",
        "explanation": "Checks supported shell snippets with shellcheck-rs. External sources and rc files are not read; fixes require review.",
        "fix_availability": "unsafe",
        "help": "Configure shell, disable, enable, extended-analysis and severity under lint.rules.plugins.shellcheck-rs.options.",
        "maturity": "experimental",
        "name": "shellcheck-rs",
        "options_schema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "additionalProperties": false,
          "properties": {
            "disable": {
              "description": "Diagnostic codes to suppress, with optional SC prefix; these are not optional-check names.",
              "examples": [
                [
                  "SC2086",
                  "2154"
                ]
              ],
              "items": {
                "pattern": "^(SC)?[0-9]+$",
                "type": "string"
              },
              "type": "array"
            },
            "enable": {
              "description": "Optional checks to activate by exact name, or all. Numeric diagnostic codes are not accepted.",
              "examples": [
                [
                  "require-variable-braces",
                  "clarify-parse-errors"
                ],
                [
                  "all"
                ]
              ],
              "items": {
                "enum": [
                  "all",
                  "clarify-parse-errors",
                  "add-default-case",
                  "avoid-negated-conditions",
                  "avoid-nullary-conditions",
                  "check-extra-masked-returns",
                  "check-set-e-suppressed",
                  "check-unassigned-uppercase",
                  "deprecate-which",
                  "quote-safe-variables",
                  "require-double-brackets",
                  "require-double-equals",
                  "require-variable-braces",
                  "useless-use-of-cat"
                ],
                "type": "string"
              },
              "type": "array"
            },
            "extended-analysis": {
              "type": "boolean"
            },
            "severity": {
              "enum": [
                "error",
                "warning",
                "info",
                "style"
              ],
              "type": "string"
            },
            "shell": {
              "description": "Override an already supported shell's inferred dialect, unless a header directive selects one.",
              "enum": [
                "bash",
                "sh",
                "dash",
                "ksh",
                "busybox"
              ],
              "type": "string"
            }
          },
          "title": "ShellCheck plugin options",
          "type": "object"
        },
        "provider": "shellcheck-rs",
        "recommended": true,
        "requires": [
          "scripts",
          "invocations",
          "execution"
        ],
        "subcategory": "scripts"
      },
      "engine": {
        "name": "shellcheck-rs",
        "version": "1.0.0"
      },
      "id": "shellcheck-rs",
      "interface": "kjanat:actionlint/analyzer@0.1.0",
      "languages": [
        "shell"
      ],
